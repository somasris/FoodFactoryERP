// Prisma schema for FoodFactory ERP
// Phase 1.3 - Authentication, Authorization & Security Foundation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum WarehouseType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOODS
  GENERAL
  SCRAP_DAMAGED
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOODS
}

enum ValuationMethod {
  MWAC
  BATCH_ACTUAL
  STANDARD
}

enum MaterialType {
  RAW_INGREDIENT
  PACKAGING_PRIMARY
  PACKAGING_SECONDARY
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
  WHOLESALER
  DIRECT
}

enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  DISPATCH
}

enum BOMVersionStatus {
  DRAFT
  ACTIVE
  OBSOLETE
}

enum OverheadCostType {
  LABOUR
  UTILITY
  MACHINE_DEPRECIATION
  DIRECT_OVERHEAD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  REJECT
  CONFIRM
  RESERVE
  RELEASE
  FULFILL
  ISSUE
  DOWNLOAD
  POST
  CANCEL
  DISPATCH
  RECEIVE
  REVERSE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  SECURITY_ALERT
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ProductionPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RELEASED
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProductionBatchStatus {
  CREATED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionExecutionEntryType {
  STATUS_CHANGE
  MATERIAL_CONSUMPTION
  MATERIAL_RETURN
  OUTPUT_UPDATE
  MATERIAL_RESERVATION
  VARIANCE_APPROVAL
  QUALITY_INSPECTION
  COST_ENTRY
  COSTING_CALCULATION
  COSTING_FINALIZATION
  NOTE
}

enum ProductionCostingStatus {
  DRAFT
  CALCULATED
  REVIEWED
  FINALIZED
}

enum ProductionCostEntryType {
  DIRECT_LABOUR
  MACHINE_COST
  OTHER_DIRECT_EXPENSE
}

enum CostEntryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OverheadAllocationMethod {
  PER_BATCH
  PER_UNIT
  PERCENT_OF_MATERIAL
  PER_LABOUR_HOUR
}

enum QualityStatus {
  PENDING_INSPECTION
  ACCEPTED
  QUARANTINED
  REJECTED
}

enum InspectionDecision {
  PENDING
  ACCEPTED
  PARTIALLY_ACCEPTED
  QUARANTINED
  REJECTED
}

enum VarianceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

enum TransferDocumentStatus {
  DRAFT
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum InventoryTransactionType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum PickingStrategy {
  FIFO
  FEFO
}

enum AdjustmentReason {
  PHYSICAL_COUNT
  DAMAGE
  SPOILAGE
  EXPIRY
  SHRINKAGE
  OPENING_STOCK
  OTHER
}

enum StockAuditStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum ComplianceDocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  UNAVAILABLE
}

enum BackupVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum RestoreRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------------------
// 0. FOUNDATION & CONFIG
// ------------------------------------------------------------------------------

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") @db.VarChar(50)
  valueType   String   @default("STRING") @map("value_type") @db.VarChar(20)
  description String?
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SystemConfigUpdater", fields: [updatedById], references: [id])

  @@index([category])
  @@map("system_configs")
}

// ------------------------------------------------------------------------------
// 1. ORGANIZATION & FACILITY SCOPING
// ------------------------------------------------------------------------------

model Company {
  id                      String   @id @default(uuid())
  code                    String   @unique @db.VarChar(20)
  legalName               String   @map("legal_name") @db.VarChar(150)
  tradeName               String?  @map("trade_name") @db.VarChar(150)
  gstin                   String   @unique @db.VarChar(15)
  pan                     String   @db.VarChar(10)
  state                   String   @db.VarChar(50)
  stateCode               String   @map("state_code") @db.VarChar(2)
  email                   String?  @db.VarChar(100)
  phone                   String?  @db.VarChar(20)
  address                 String   @db.Text
  logoUrl                 String?  @map("logo_url") @db.VarChar(500)
  registrationNumber      String?  @map("registration_number") @db.VarChar(100)
  fssaiLicense            String?  @map("fssai_license") @db.VarChar(30)
  financialYearStartMonth Int      @default(4) @map("financial_year_start_month")
  defaultCurrency         String   @default("INR") @map("default_currency") @db.VarChar(10)
  defaultTimezone         String   @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(50)
  preferences             Json?
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  factories     Factory[]
  users         User[]
  salesInvoices SalesInvoice[]

  @@map("companies")
}

model Factory {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  code            String   @unique @db.VarChar(20)
  name            String   @db.VarChar(100)
  state           String   @db.VarChar(50)
  stateCode       String   @map("state_code") @db.VarChar(2)
  address         String   @db.Text
  email           String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  operationalInfo Json?    @map("operational_info")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]

  @@map("factories")
}

model Warehouse {
  id            String        @id @default(uuid())
  factoryId     String        @map("factory_id")
  code          String        @unique @db.VarChar(20)
  name          String        @db.VarChar(100)
  warehouseType WarehouseType @map("warehouse_type")
  address       String?       @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  factory              Factory                @relation(fields: [factoryId], references: [id])
  userAccess           UserWarehouseAccess[]
  inventoryBalances    InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReceipts    InventoryReceipt[]
  inventoryIssues      InventoryIssue[]
  transfersFrom        InventoryTransfer[]    @relation("TransferSourceWarehouse")
  transfersTo          InventoryTransfer[]    @relation("TransferDestWarehouse")
  inventoryAdjustments InventoryAdjustment[]
  salesOrders          SalesOrder[]
  salesInvoices        SalesInvoice[]
  productionPlans      ProductionPlan[]
  workOrders           WorkOrder[]
  productionBatches    ProductionBatch[]
  batchConsumptions    ProductionBatchConsumption[]
  batchReturns         ProductionBatchReturn[]
  qualityInspections   QualityInspection[]
  stockAudits          StockAudit[]

  @@map("warehouses")
}

// ------------------------------------------------------------------------------
// 2. AUTHENTICATION & ACCESS CONTROL (RBAC)
// ------------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  companyId    String?   @map("company_id")
  email        String    @unique @db.VarChar(100)
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company         Company?              @relation(fields: [companyId], references: [id])
  userRoles       UserRole[]
  warehouseAccess UserWarehouseAccess[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  postedInventoryTransactions InventoryTransaction[] @relation("TxPostedBy")
  salesOrders                 SalesOrder[]           @relation("SalesmanOrders")
  salesOrderStatusChanges     SalesOrderStatusHistory[]
  salesInvoiceStatusChanges   SalesInvoiceStatusHistory[]
  productionPlanStatusChanges ProductionPlanStatusHistory[]
  assignedWorkOrders          WorkOrder[]                   @relation("WorkOrderAssignee")
  workOrderStatusChanges      WorkOrderStatusHistory[]
  operatedBatches             ProductionBatch[]             @relation("BatchOperator")
  batchStatusChanges          ProductionBatchStatusHistory[]
  batchExecutionEntries       ProductionExecutionEntry[]
  batchConsumptions           ProductionBatchConsumption[]
  batchReturns                ProductionBatchReturn[]
  varianceApprovals           ProductionBatchVarianceApproval[]
  qualityInspections          QualityInspection[]           @relation("QualityInspector")
  qualityReleases             QualityInspection[]           @relation("QualityReleaser")
  costingsCalculated          ProductionBatchCosting[]      @relation("CostingCalculator")
  costingsReviewed            ProductionBatchCosting[]      @relation("CostingReviewer")
  costingsFinalized           ProductionBatchCosting[]      @relation("CostingFinalizer")
  costEntriesRecorded         ProductionCostEntry[]         @relation("CostEntryRecorder")
  costEntriesApproved         ProductionCostEntry[]         @relation("CostEntryApprover")
  overheadAllocations         ProductionOverheadAllocation[]
  costingHistoryChanges       ProductionCostingHistory[]
  updatedSystemConfigs        SystemConfig[]                @relation("SystemConfigUpdater")
  stockAuditsCreated          StockAudit[]                  @relation("StockAuditCreator")
  complianceDocsUploaded      ComplianceDocument[]          @relation("ComplianceDocUploader")
  complianceDocsVerified      ComplianceDocument[]          @relation("ComplianceDocVerifier")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(50)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(30)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserWarehouseAccess {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  warehouseId String   @map("warehouse_id")
  accessLevel String   @default("READ_WRITE") @map("access_level") @db.VarChar(20)
  assignedAt  DateTime @default(now()) @map("assigned_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@map("user_warehouse_access")
}

// ------------------------------------------------------------------------------
// 3. SESSION MANAGEMENT & REFRESH TOKEN ROTATION
// ------------------------------------------------------------------------------

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  family    String   @db.VarChar(64)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------------------------
// 4. SECURITY & AUDIT LOGGING
// ------------------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(50)
  entityId      String      @map("entity_id") @db.VarChar(36)
  previousState Json?       @map("previous_state")
  newState      Json?       @map("new_state")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.Text
  remarks       String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 5. MASTER DATA MANAGEMENT (PHASE 1.4)
// ------------------------------------------------------------------------------

model UnitOfMeasure {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(10)
  name          String   @db.VarChar(50)
  symbol        String   @db.VarChar(10)
  category      String   @default("GENERAL") @db.VarChar(30)
  isBaseUnit    Boolean  @default(false) @map("is_base_unit")
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  conversionsFrom UnitConversion[] @relation("FromUOM")
  conversionsTo   UnitConversion[] @relation("ToUOM")
  rawMaterials    RawMaterial[]
  products        Product[]
  productVariants ProductVariant[]
  inventoryItems  InventoryItem[]
  boms            BOM[]
  bomVersions     BOMVersion[]
  bomItems        BOMItem[]
  txLines         InventoryTransactionLine[] @relation("TxLineUom")
  txBaseLines     InventoryTransactionLine[] @relation("TxLineBaseUom")
  receiptLines      InventoryReceiptLine[]
  issueLines        InventoryIssueLine[]
  transferLines     InventoryTransferLine[]
  adjustmentLines   InventoryAdjustmentLine[]
  salesOrderLines   SalesOrderLine[]
  salesInvoiceLines   SalesInvoiceLine[]
  productionPlanItems ProductionPlanItem[]
  workOrders          WorkOrder[]
  productionBatches   ProductionBatch[]
  batchConsumptions   ProductionBatchConsumption[]
  batchReturns        ProductionBatchReturn[]

  @@map("units_of_measure")
}

model UnitConversion {
  id         String   @id @default(uuid())
  fromUomId  String   @map("from_uom_id")
  toUomId    String   @map("to_uom_id")
  multiplier Decimal  @db.Decimal(18, 6)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  fromUom UnitOfMeasure @relation("FromUOM", fields: [fromUomId], references: [id])
  toUom   UnitOfMeasure @relation("ToUOM", fields: [toUomId], references: [id])

  @@unique([fromUomId, toUomId])
  @@map("unit_conversions")
}

model TaxRate {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(20)
  name           String   @db.VarChar(50)
  ratePercentage Decimal  @map("rate_percentage") @db.Decimal(5, 2)
  cgstPercentage Decimal  @map("cgst_percentage") @db.Decimal(5, 2)
  sgstPercentage Decimal  @map("sgst_percentage") @db.Decimal(5, 2)
  igstPercentage Decimal  @map("igst_percentage") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rawMaterials      RawMaterial[]
  products          Product[]
  configurations    TaxConfiguration[]
  salesOrderLines   SalesOrderLine[]
  salesInvoiceLines SalesInvoiceLine[]

  @@map("tax_rates")
}

model TaxConfiguration {
  id            String    @id @default(uuid())
  hsnCode       String    @map("hsn_code") @db.VarChar(10)
  description   String?   @db.VarChar(255)
  taxRateId     String    @map("tax_rate_id")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  taxRate TaxRate @relation(fields: [taxRateId], references: [id])

  @@index([hsnCode])
  @@index([taxRateId])
  @@map("tax_configurations")
}

model RawMaterialCategory {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials RawMaterial[]

  @@map("raw_material_categories")
}

model RawMaterial {
  id              String       @id @default(uuid())
  categoryId      String       @map("category_id")
  code            String       @unique @db.VarChar(30)
  name            String       @db.VarChar(100)
  description     String?      @db.Text
  materialType    MaterialType @map("material_type")
  uomId           String       @map("uom_id")
  hsnCode         String       @map("hsn_code") @db.VarChar(10)
  taxRateId       String       @map("tax_rate_id")
  minStockAlert   Decimal      @default(0) @map("min_stock_alert") @db.Decimal(14, 4)
  reorderQuantity Decimal?     @map("reorder_quantity") @db.Decimal(14, 4)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  category      RawMaterialCategory @relation(fields: [categoryId], references: [id])
  uom           UnitOfMeasure       @relation(fields: [uomId], references: [id])
  taxRate       TaxRate             @relation(fields: [taxRateId], references: [id])
  inventoryItem InventoryItem?

  @@index([categoryId])
  @@index([uomId])
  @@index([taxRateId])
  @@map("raw_materials")
}

model ProductCategory {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  baseUomId   String   @map("base_uom_id")
  hsnCode     String   @map("hsn_code") @db.VarChar(10)
  taxRateId   String   @map("tax_rate_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category ProductCategory  @relation(fields: [categoryId], references: [id])
  baseUom  UnitOfMeasure    @relation(fields: [baseUomId], references: [id])
  taxRate           TaxRate           @relation(fields: [taxRateId], references: [id])
  variants          ProductVariant[]
  productionBatches ProductionBatch[]

  @@index([categoryId])
  @@index([baseUomId])
  @@index([taxRateId])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid())
  productId           String   @map("product_id")
  sku                 String   @unique @db.VarChar(30)
  name                String   @db.VarChar(100)
  netWeightGrams      Decimal  @map("net_weight_grams") @db.Decimal(10, 2)
  uomId               String   @map("uom_id")
  defaultSellingPrice Decimal  @map("default_selling_price") @db.Decimal(12, 2)
  shelfLifeDays       Int?     @map("shelf_life_days")
  barcode             String?  @unique @db.VarChar(50)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product           Product            @relation(fields: [productId], references: [id])
  uom               UnitOfMeasure      @relation(fields: [uomId], references: [id])
  inventoryItem     InventoryItem?
  boms              BOM[]
  salesOrderLines     SalesOrderLine[]
  salesInvoiceLines   SalesInvoiceLine[]
  productionPlanItems ProductionPlanItem[]
  workOrders          WorkOrder[]
  productionBatches   ProductionBatch[]

  @@index([productId])
  @@index([uomId])
  @@map("product_variants")
}

model InventoryItem {
  id                String          @id @default(uuid())
  itemType          ItemType        @map("item_type")
  rawMaterialId     String?         @unique @map("raw_material_id")
  productVariantId  String?         @unique @map("product_variant_id")
  code              String          @unique @db.VarChar(30)
  name              String          @db.VarChar(100)
  uomId             String          @map("uom_id")
  valuationMethod   ValuationMethod @default(MWAC) @map("valuation_method")
  movingAverageCost Decimal         @default(0) @map("moving_average_cost") @db.Decimal(18, 4)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  rawMaterial      RawMaterial?               @relation(fields: [rawMaterialId], references: [id])
  productVariant   ProductVariant?            @relation(fields: [productVariantId], references: [id])
  uom              UnitOfMeasure              @relation(fields: [uomId], references: [id])
  bomItems         BOMItem[]
  batches          InventoryBatch[]
  balances         InventoryBalance[]
  transactionLines InventoryTransactionLine[]
  receiptLines     InventoryReceiptLine[]
  issueLines       InventoryIssueLine[]
  transferLines    InventoryTransferLine[]
  adjustmentLines   InventoryAdjustmentLine[]
  salesOrderLines           SalesOrderLine[]
  salesInvoiceLines         SalesInvoiceLine[]
  productionPlanItems       ProductionPlanItem[]
  productionPlanMaterials   ProductionPlanMaterialRequirement[]
  workOrders                WorkOrder[]
  productionBatches         ProductionBatch[]
  batchConsumptions         ProductionBatchConsumption[]
  batchReturns              ProductionBatchReturn[]
  varianceApprovals         ProductionBatchVarianceApproval[]

  @@map("inventory_items")
}

model Supplier {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(20)
  legalName        String   @map("legal_name") @db.VarChar(150)
  tradeName        String?  @map("trade_name") @db.VarChar(150)
  contactName      String?  @map("contact_name") @db.VarChar(100)
  email            String?  @db.VarChar(100)
  phone            String?  @db.VarChar(20)
  gstin            String?  @unique @db.VarChar(15)
  pan              String?  @db.VarChar(10)
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  addresses SupplierAddress[]

  @@map("suppliers")
}

model SupplierAddress {
  id           String      @id @default(uuid())
  supplierId   String      @map("supplier_id")
  addressType  AddressType @default(OFFICE) @map("address_type")
  addressLine1 String      @map("address_line1") @db.VarChar(255)
  city         String      @db.VarChar(50)
  state        String      @db.VarChar(50)
  stateCode    String      @map("state_code") @db.VarChar(2)
  pincode      String      @db.VarChar(10)
  isDefault    Boolean     @default(true) @map("is_default")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_addresses")
}

model Customer {
  id               String       @id @default(uuid())
  code             String       @unique @db.VarChar(20)
  legalName        String       @map("legal_name") @db.VarChar(150)
  tradeName        String?      @map("trade_name") @db.VarChar(150)
  customerType     CustomerType @map("customer_type")
  contactName      String?      @map("contact_name") @db.VarChar(100)
  email            String?      @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  gstin            String?      @unique @db.VarChar(15)
  pan              String?      @db.VarChar(10)
  creditPeriodDays Int          @default(15) @map("credit_period_days")
  creditLimit      Decimal      @default(0) @map("credit_limit") @db.Decimal(14, 2)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  addresses     CustomerAddress[]
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  @@map("customers")
}

model CustomerAddress {
  id           String      @id @default(uuid())
  customerId   String      @map("customer_id")
  addressType  AddressType @default(SHIPPING) @map("address_type")
  addressLine1 String      @map("address_line1") @db.VarChar(255)
  city         String      @db.VarChar(50)
  state        String      @db.VarChar(50)
  stateCode    String      @map("state_code") @db.VarChar(2)
  pincode      String      @db.VarChar(10)
  isDefault    Boolean     @default(true) @map("is_default")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  @@index([customerId])
  @@map("customer_addresses")
}

model BOM {
  id                 String   @id @default(uuid())
  productVariantId   String   @map("product_variant_id")
  code               String   @unique @db.VarChar(30)
  name               String   @db.VarChar(100)
  baseOutputQuantity Decimal  @map("base_output_quantity") @db.Decimal(14, 4)
  outputUomId        String   @map("output_uom_id")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  productVariant      ProductVariant       @relation(fields: [productVariantId], references: [id])
  outputUom           UnitOfMeasure        @relation(fields: [outputUomId], references: [id])
  versions            BOMVersion[]
  productionPlanItems ProductionPlanItem[]
  workOrders          WorkOrder[]
  productionBatches   ProductionBatch[]

  @@index([productVariantId])
  @@map("boms")
}

model BOMVersion {
  id                 String           @id @default(uuid())
  bomId              String           @map("bom_id")
  versionNumber      Int              @map("version_number")
  status             BOMVersionStatus @default(DRAFT)
  effectiveFrom      DateTime         @default(now()) @map("effective_from") @db.Date
  effectiveTo        DateTime?        @map("effective_to") @db.Date
  expectedGoodOutput     Decimal          @map("expected_good_output") @db.Decimal(14, 4)
  yieldPercentage        Decimal          @default(100) @map("yield_percentage") @db.Decimal(5, 2)
  expectedWastagePercent Decimal          @default(0) @map("expected_wastage_percent") @db.Decimal(5, 2)
  outputUomId            String           @map("output_uom_id")
  approvedById       String?          @map("approved_by_id")
  approvedAt         DateTime?        @map("approved_at")
  remarks            String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  bom                 BOM                  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  outputUom           UnitOfMeasure        @relation(fields: [outputUomId], references: [id])
  items               BOMItem[]
  overheads           BOMOverhead[]
  productionPlanItems ProductionPlanItem[]
  workOrders          WorkOrder[]
  productionBatches   ProductionBatch[]

  @@unique([bomId, versionNumber])
  @@map("bom_versions")
}

model BOMItem {
  id                    String   @id @default(uuid())
  bomVersionId          String   @map("bom_version_id")
  inventoryItemId       String   @map("inventory_item_id")
  itemType              ItemType @map("item_type")
  standardQuantity      Decimal  @map("standard_quantity") @db.Decimal(14, 4)
  uomId                 String   @map("uom_id")
  scrapTolerancePercent Decimal  @default(0) @map("scrap_tolerance_percent") @db.Decimal(5, 2)

  bomVersion    BOMVersion    @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([bomVersionId])
  @@index([inventoryItemId])
  @@map("bom_items")
}

model BOMOverhead {
  id             String           @id @default(uuid())
  bomVersionId   String           @map("bom_version_id")
  costType       OverheadCostType @map("cost_type")
  description    String           @db.VarChar(150)
  standardAmount Decimal          @map("standard_amount") @db.Decimal(12, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  bomVersion          BOMVersion                     @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  overheadAllocations ProductionOverheadAllocation[]

  @@index([bomVersionId])
  @@map("bom_overheads")
}


// ------------------------------------------------------------------------------
// 6. INVENTORY MANAGEMENT (PHASE 1.5 - STAGE 3)
// ------------------------------------------------------------------------------

model InventoryBatch {
  id                String    @id @default(uuid())
  inventoryItemId   String    @map("inventory_item_id")
  batchNumber       String    @map("batch_number") @db.VarChar(60)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  receivedDate      DateTime      @default(now()) @map("received_date")
  unitCost          Decimal       @default(0) @map("unit_cost") @db.Decimal(18, 4)
  qualityStatus     QualityStatus @default(ACCEPTED) @map("quality_status")
  supplierBatchRef  String?       @map("supplier_batch_ref") @db.VarChar(60)
  notes             String?   @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  inventoryItem    InventoryItem              @relation(fields: [inventoryItemId], references: [id])
  balances         InventoryBalance[]
  transactionLines InventoryTransactionLine[]
  receiptLines     InventoryReceiptLine[]
  issueLines       InventoryIssueLine[]
  transferLines        InventoryTransferLine[]
  adjustmentLines      InventoryAdjustmentLine[]
  producedFromBatches  ProductionBatch[]            @relation("FinishedGoodsBatch")
  consumedInBatches    ProductionBatchConsumption[]
  returnedFromBatches  ProductionBatchReturn[]
  qualityInspections   QualityInspection[]

  @@unique([inventoryItemId, batchNumber])
  @@index([inventoryItemId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model InventoryBalance {
  id                String    @id @default(uuid())
  warehouseId       String    @map("warehouse_id")
  inventoryItemId   String    @map("inventory_item_id")
  batchId           String?   @map("batch_id")
  quantityOnHand    Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  quantityReserved  Decimal   @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  unitCost          Decimal   @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalValue        Decimal   @default(0) @map("total_value") @db.Decimal(18, 4)
  lastTransactionAt DateTime? @map("last_transaction_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  batch         InventoryBatch? @relation(fields: [batchId], references: [id])

  @@unique([warehouseId, inventoryItemId, batchId])
  @@index([warehouseId])
  @@index([inventoryItemId])
  @@index([batchId])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id                    String                   @id @default(uuid())
  transactionNumber     String                   @unique @map("transaction_number") @db.VarChar(40)
  transactionType       InventoryTransactionType @map("transaction_type")
  referenceType         String                   @map("reference_type") @db.VarChar(40)
  referenceId           String                   @map("reference_id") @db.VarChar(36)
  referenceNumber       String                   @map("reference_number") @db.VarChar(40)
  idempotencyKey        String                   @unique @map("idempotency_key") @db.VarChar(100)
  warehouseId           String                   @map("warehouse_id")
  reversedTransactionId String?                  @unique @map("reversed_transaction_id")
  transactionDate       DateTime                 @default(now()) @map("transaction_date")
  postedById            String                   @map("posted_by_id")
  remarks               String?                  @db.Text
  createdAt             DateTime                 @default(now()) @map("created_at")

  warehouse           Warehouse                  @relation(fields: [warehouseId], references: [id])
  postedBy            User                       @relation("TxPostedBy", fields: [postedById], references: [id])
  reversedTransaction InventoryTransaction?      @relation("TxReversal", fields: [reversedTransactionId], references: [id])
  reversalOf          InventoryTransaction?      @relation("TxReversal")
  lines               InventoryTransactionLine[]

  @@index([referenceType, referenceId])
  @@index([warehouseId])
  @@index([transactionDate])
  @@map("inventory_transactions")
}

model InventoryTransactionLine {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  lineNumber      Int      @map("line_number")
  inventoryItemId String   @map("inventory_item_id")
  batchId         String?  @map("batch_id")
  uomId           String   @map("uom_id")
  quantity        Decimal  @db.Decimal(18, 4)
  baseUomId       String   @map("base_uom_id")
  baseQuantity    Decimal  @map("base_quantity") @db.Decimal(18, 4)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(18, 4)
  totalCost       Decimal  @map("total_cost") @db.Decimal(18, 4)
  balanceAfter    Decimal  @map("balance_after") @db.Decimal(18, 4)
  mwacAfter       Decimal? @map("mwac_after") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id])
  inventoryItem InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  batch         InventoryBatch?      @relation(fields: [batchId], references: [id])
  uom           UnitOfMeasure        @relation("TxLineUom", fields: [uomId], references: [id])
  baseUom       UnitOfMeasure        @relation("TxLineBaseUom", fields: [baseUomId], references: [id])

  @@unique([transactionId, lineNumber])
  @@index([inventoryItemId])
  @@index([batchId])
  @@map("inventory_transaction_lines")
}

model InventoryReceipt {
  id             String                  @id @default(uuid())
  receiptNumber  String                  @unique @map("receipt_number") @db.VarChar(40)
  warehouseId    String                  @map("warehouse_id")
  status         InventoryDocumentStatus @default(DRAFT)
  receiptDate    DateTime                @default(now()) @map("receipt_date")
  supplierRef    String?                 @map("supplier_ref") @db.VarChar(100)
  notes          String?                 @db.Text
  idempotencyKey String?                 @unique @map("idempotency_key") @db.VarChar(100)
  createdById    String                  @map("created_by_id")
  submittedById  String?                 @map("submitted_by_id")
  submittedAt    DateTime?               @map("submitted_at")
  approvedById   String?                 @map("approved_by_id")
  approvedAt     DateTime?               @map("approved_at")
  postedById     String?                 @map("posted_by_id")
  postedAt       DateTime?               @map("posted_at")
  cancelledById  String?                 @map("cancelled_by_id")
  cancelledAt    DateTime?               @map("cancelled_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  warehouse Warehouse              @relation(fields: [warehouseId], references: [id])
  lines     InventoryReceiptLine[]

  @@index([warehouseId])
  @@index([status])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id                String    @id @default(uuid())
  receiptId         String    @map("receipt_id")
  lineNumber        Int       @map("line_number")
  inventoryItemId   String    @map("inventory_item_id")
  uomId             String    @map("uom_id")
  quantity          Decimal   @db.Decimal(18, 4)
  baseQuantity      Decimal   @map("base_quantity") @db.Decimal(18, 4)
  unitCost          Decimal   @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal   @map("total_cost") @db.Decimal(18, 4)
  batchNumber       String?   @map("batch_number") @db.VarChar(60)
  batchId           String?   @map("batch_id")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  notes             String?   @db.Text

  receipt       InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  uom           UnitOfMeasure    @relation(fields: [uomId], references: [id])
  batch         InventoryBatch?  @relation(fields: [batchId], references: [id])

  @@unique([receiptId, lineNumber])
  @@index([inventoryItemId])
  @@map("inventory_receipt_lines")
}

model InventoryIssue {
  id              String                  @id @default(uuid())
  issueNumber     String                  @unique @map("issue_number") @db.VarChar(40)
  warehouseId     String                  @map("warehouse_id")
  status          InventoryDocumentStatus @default(DRAFT)
  pickingStrategy PickingStrategy         @default(FEFO) @map("picking_strategy")
  issueDate       DateTime                @default(now()) @map("issue_date")
  departmentRef   String?                 @map("department_ref") @db.VarChar(100)
  purpose         String?                 @db.VarChar(150)
  notes           String?                 @db.Text
  idempotencyKey  String?                 @unique @map("idempotency_key") @db.VarChar(100)
  createdById     String                  @map("created_by_id")
  submittedById   String?                 @map("submitted_by_id")
  submittedAt     DateTime?               @map("submitted_at")
  approvedById    String?                 @map("approved_by_id")
  approvedAt      DateTime?               @map("approved_at")
  postedById      String?                 @map("posted_by_id")
  postedAt        DateTime?               @map("posted_at")
  cancelledById   String?                 @map("cancelled_by_id")
  cancelledAt     DateTime?               @map("cancelled_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  lines     InventoryIssueLine[]

  @@index([warehouseId])
  @@index([status])
  @@map("inventory_issues")
}

model InventoryIssueLine {
  id                String  @id @default(uuid())
  issueId           String  @map("issue_id")
  lineNumber        Int     @map("line_number")
  inventoryItemId   String  @map("inventory_item_id")
  uomId             String  @map("uom_id")
  requestedQuantity Decimal @map("requested_quantity") @db.Decimal(18, 4)
  baseQuantity      Decimal @map("base_quantity") @db.Decimal(18, 4)
  batchId           String? @map("batch_id")
  unitCost          Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal @default(0) @map("total_cost") @db.Decimal(18, 4)
  notes             String? @db.Text

  issue         InventoryIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  uom           UnitOfMeasure   @relation(fields: [uomId], references: [id])
  batch         InventoryBatch? @relation(fields: [batchId], references: [id])

  @@unique([issueId, lineNumber])
  @@index([inventoryItemId])
  @@map("inventory_issue_lines")
}

model InventoryTransfer {
  id                     String                 @id @default(uuid())
  transferNumber         String                 @unique @map("transfer_number") @db.VarChar(40)
  sourceWarehouseId      String                 @map("source_warehouse_id")
  destinationWarehouseId String                 @map("destination_warehouse_id")
  status                 TransferDocumentStatus @default(DRAFT)
  transferDate           DateTime               @default(now()) @map("transfer_date")
  notes                  String?                @db.Text
  dispatchIdempotencyKey String?                @unique @map("dispatch_idempotency_key") @db.VarChar(100)
  receiveIdempotencyKey  String?                @unique @map("receive_idempotency_key") @db.VarChar(100)
  createdById            String                 @map("created_by_id")
  approvedById           String?                @map("approved_by_id")
  approvedAt             DateTime?              @map("approved_at")
  dispatchedById         String?                @map("dispatched_by_id")
  dispatchedAt           DateTime?              @map("dispatched_at")
  receivedById           String?                @map("received_by_id")
  receivedAt             DateTime?              @map("received_at")
  cancelledById          String?                @map("cancelled_by_id")
  cancelledAt            DateTime?              @map("cancelled_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  sourceWarehouse      Warehouse               @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse               @relation("TransferDestWarehouse", fields: [destinationWarehouseId], references: [id])
  lines                InventoryTransferLine[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                     String  @id @default(uuid())
  transferId             String  @map("transfer_id")
  lineNumber             Int     @map("line_number")
  inventoryItemId        String  @map("inventory_item_id")
  batchId                String? @map("batch_id")
  uomId                  String  @map("uom_id")
  quantity               Decimal @db.Decimal(18, 4)
  baseQuantity           Decimal @map("base_quantity") @db.Decimal(18, 4)
  dispatchedBaseQuantity Decimal @default(0) @map("dispatched_base_quantity") @db.Decimal(18, 4)
  receivedBaseQuantity   Decimal @default(0) @map("received_base_quantity") @db.Decimal(18, 4)
  unitCost               Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost              Decimal @default(0) @map("total_cost") @db.Decimal(18, 4)
  notes                  String? @db.Text

  transfer      InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  batch         InventoryBatch?   @relation(fields: [batchId], references: [id])
  uom           UnitOfMeasure     @relation(fields: [uomId], references: [id])

  @@unique([transferId, lineNumber])
  @@index([inventoryItemId])
  @@map("inventory_transfer_lines")
}

model InventoryAdjustment {
  id               String                  @id @default(uuid())
  adjustmentNumber String                  @unique @map("adjustment_number") @db.VarChar(40)
  warehouseId      String                  @map("warehouse_id")
  status           InventoryDocumentStatus @default(DRAFT)
  adjustmentDate   DateTime                @default(now()) @map("adjustment_date")
  reason           AdjustmentReason
  notes            String?                 @db.Text
  idempotencyKey   String?                 @unique @map("idempotency_key") @db.VarChar(100)
  createdById      String                  @map("created_by_id")
  submittedById    String?                 @map("submitted_by_id")
  submittedAt      DateTime?               @map("submitted_at")
  approvedById     String?                 @map("approved_by_id")
  approvedAt       DateTime?               @map("approved_at")
  postedById       String?                 @map("posted_by_id")
  postedAt         DateTime?               @map("posted_at")
  cancelledById    String?                 @map("cancelled_by_id")
  cancelledAt      DateTime?               @map("cancelled_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  warehouse Warehouse                 @relation(fields: [warehouseId], references: [id])
  lines     InventoryAdjustmentLine[]

  @@index([warehouseId])
  @@index([status])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id                String  @id @default(uuid())
  adjustmentId      String  @map("adjustment_id")
  lineNumber        Int     @map("line_number")
  inventoryItemId   String  @map("inventory_item_id")
  batchId           String? @map("batch_id")
  uomId             String  @map("uom_id")
  quantityDelta     Decimal @map("quantity_delta") @db.Decimal(18, 4)
  baseQuantityDelta Decimal @map("base_quantity_delta") @db.Decimal(18, 4)
  unitCost          Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal @default(0) @map("total_cost") @db.Decimal(18, 4)
  reasonNote        String? @map("reason_note") @db.Text

  adjustment    InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  batch         InventoryBatch?     @relation(fields: [batchId], references: [id])
  uom           UnitOfMeasure       @relation(fields: [uomId], references: [id])

  @@unique([adjustmentId, lineNumber])
  @@index([inventoryItemId])
  @@map("inventory_adjustment_lines")
}


// ------------------------------------------------------------------------------
// 7. SALES & ORDERS (PHASE 2)
// ------------------------------------------------------------------------------

model SalesOrder {
  id                   String           @id @default(uuid())
  orderNumber          String           @unique @map("order_number") @db.VarChar(40)
  customerId           String           @map("customer_id")
  shippingAddressId    String?          @map("shipping_address_id")
  warehouseId          String           @map("warehouse_id")
  salesmanId           String?          @map("salesman_id")
  orderDate            DateTime         @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?        @map("expected_delivery_date") @db.Date
  status               SalesOrderStatus @default(DRAFT)
  subtotal             Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount       Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount            Decimal          @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal          @default(0) @map("total_amount") @db.Decimal(14, 2)
  notes                String?          @db.Text
  deliveryInstructions String?          @map("delivery_instructions") @db.Text
  idempotencyKey       String?          @unique @map("idempotency_key") @db.VarChar(100)
  createdById          String           @map("created_by_id")
  submittedById        String?          @map("submitted_by_id")
  submittedAt          DateTime?        @map("submitted_at")
  approvedById         String?          @map("approved_by_id")
  approvedAt           DateTime?        @map("approved_at")
  rejectedById         String?          @map("rejected_by_id")
  rejectedAt           DateTime?        @map("rejected_at")
  rejectionReason      String?          @map("rejection_reason") @db.Text
  confirmedById        String?          @map("confirmed_by_id")
  confirmedAt          DateTime?        @map("confirmed_at")
  cancelledById        String?          @map("cancelled_by_id")
  cancelledAt          DateTime?        @map("cancelled_at")
  cancellationReason   String?          @map("cancellation_reason") @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  customer        Customer                  @relation(fields: [customerId], references: [id])
  shippingAddress CustomerAddress?          @relation(fields: [shippingAddressId], references: [id])
  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id])
  salesman        User?                     @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  lines           SalesOrderLine[]
  statusHistory   SalesOrderStatusHistory[]
  fulfillments          SalesOrderFulfillment[]
  invoices              SalesInvoice[]
  productionDemandLinks ProductionPlanDemandSource[]

  @@index([customerId])
  @@index([warehouseId])
  @@index([salesmanId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                    String   @id @default(uuid())
  salesOrderId          String   @map("sales_order_id")
  lineNumber            Int      @map("line_number")
  productVariantId      String   @map("product_variant_id")
  inventoryItemId       String   @map("inventory_item_id")
  uomId                 String   @map("uom_id")
  orderedQuantity       Decimal  @map("ordered_quantity") @db.Decimal(14, 4)
  baseQuantity          Decimal  @map("base_quantity") @db.Decimal(14, 4)
  reservedBaseQuantity  Decimal  @default(0) @map("reserved_base_quantity") @db.Decimal(14, 4)
  fulfilledBaseQuantity Decimal  @default(0) @map("fulfilled_base_quantity") @db.Decimal(14, 4)
  invoicedBaseQuantity  Decimal  @default(0) @map("invoiced_base_quantity") @db.Decimal(14, 4)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPercent       Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRateId             String   @map("tax_rate_id")
  taxPercentage         Decimal  @map("tax_percentage") @db.Decimal(5, 2)
  taxableAmount         Decimal  @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount             Decimal  @map("tax_amount") @db.Decimal(14, 2)
  lineTotal             Decimal  @map("line_total") @db.Decimal(14, 2)
