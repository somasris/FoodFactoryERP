model ProductionPlan {
  id                 String               @id @default(uuid())
  planNumber         String               @unique @map("plan_number") @db.VarChar(40)
  name               String?              @db.VarChar(150)
  warehouseId        String               @map("warehouse_id")
  planDate           DateTime             @default(now()) @map("plan_date")
  targetStartDate    DateTime?            @map("target_start_date") @db.Date
  targetEndDate      DateTime?            @map("target_end_date") @db.Date
  status             ProductionPlanStatus @default(DRAFT)
  notes              String?              @db.Text
  idempotencyKey     String?              @unique @map("idempotency_key") @db.VarChar(100)
  createdById        String               @map("created_by_id")
  submittedById      String?              @map("submitted_by_id")
  submittedAt        DateTime?            @map("submitted_at")
  approvedById       String?              @map("approved_by_id")
  approvedAt         DateTime?            @map("approved_at")
  rejectedById       String?              @map("rejected_by_id")
  rejectedAt         DateTime?            @map("rejected_at")
  rejectionReason    String?              @map("rejection_reason") @db.Text
  releasedById       String?              @map("released_by_id")
  releasedAt         DateTime?            @map("released_at")
  cancelledById      String?              @map("cancelled_by_id")
  cancelledAt        DateTime?            @map("cancelled_at")
  cancellationReason String?              @map("cancellation_reason") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  warehouse            Warehouse                           @relation(fields: [warehouseId], references: [id])
  items                ProductionPlanItem[]
  materialRequirements ProductionPlanMaterialRequirement[]
  statusHistory        ProductionPlanStatusHistory[]
  workOrders           WorkOrder[]

  @@index([warehouseId])
  @@index([status])
  @@index([planDate])
  @@map("production_plans")
}

model ProductionPlanItem {
  id                      String   @id @default(uuid())
  productionPlanId        String   @map("production_plan_id")
  lineNumber              Int      @map("line_number")
  productVariantId        String   @map("product_variant_id")
  inventoryItemId         String   @map("inventory_item_id")
  bomId                   String   @map("bom_id")
  bomVersionId            String   @map("bom_version_id")
  uomId                   String   @map("uom_id")
  demandQuantity          Decimal  @map("demand_quantity") @db.Decimal(14, 4)
  availableFgQuantity     Decimal  @default(0) @map("available_fg_quantity") @db.Decimal(14, 4)
  existingPlannedQuantity Decimal  @default(0) @map("existing_planned_quantity") @db.Decimal(14, 4)
  netRequirementQuantity  Decimal  @map("net_requirement_quantity") @db.Decimal(14, 4)
  plannedQuantity         Decimal  @map("planned_quantity") @db.Decimal(14, 4)
  workOrderedQuantity     Decimal  @default(0) @map("work_ordered_quantity") @db.Decimal(14, 4)
  yieldPercentage         Decimal  @default(100) @map("yield_percentage") @db.Decimal(5, 2)
  expectedWastagePercent  Decimal  @default(0) @map("expected_wastage_percent") @db.Decimal(5, 2)
  estimatedMaterialCost   Decimal  @default(0) @map("estimated_material_cost") @db.Decimal(14, 2)
  estimatedOverheadCost   Decimal  @default(0) @map("estimated_overhead_cost") @db.Decimal(14, 2)
  estimatedTotalCost      Decimal  @default(0) @map("estimated_total_cost") @db.Decimal(14, 2)

  productionPlan       ProductionPlan                      @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productVariant       ProductVariant                      @relation(fields: [productVariantId], references: [id])
  inventoryItem        InventoryItem                       @relation(fields: [inventoryItemId], references: [id])
  bom                  BOM                                 @relation(fields: [bomId], references: [id])
  bomVersion           BOMVersion                          @relation(fields: [bomVersionId], references: [id])
  uom                  UnitOfMeasure                       @relation(fields: [uomId], references: [id])
  demandSources        ProductionPlanDemandSource[]
  materialRequirements ProductionPlanMaterialRequirement[]
  workOrders           WorkOrder[]

  @@unique([productionPlanId, lineNumber])
  @@index([productVariantId])
  @@index([bomVersionId])
  @@map("production_plan_items")
}

model ProductionPlanDemandSource {
  id                    String  @id @default(uuid())
  productionPlanItemId  String  @map("production_plan_item_id")
  salesOrderId          String  @map("sales_order_id")
  salesOrderLineId      String  @map("sales_order_line_id")
  allocatedBaseQuantity Decimal @map("allocated_base_quantity") @db.Decimal(14, 4)

  productionPlanItem ProductionPlanItem @relation(fields: [productionPlanItemId], references: [id], onDelete: Cascade)
  salesOrder         SalesOrder         @relation(fields: [salesOrderId], references: [id])
  salesOrderLine     SalesOrderLine     @relation(fields: [salesOrderLineId], references: [id])

  @@index([salesOrderId])
  @@index([salesOrderLineId])
  @@map("production_plan_demand_sources")
}

model ProductionPlanMaterialRequirement {
  id                   String   @id @default(uuid())
  productionPlanId     String   @map("production_plan_id")
  productionPlanItemId String   @map("production_plan_item_id")
  inventoryItemId      String   @map("inventory_item_id")
  itemType             ItemType @map("item_type")
  requiredBaseQuantity Decimal  @map("required_base_quantity") @db.Decimal(14, 4)
  availableQuantity    Decimal  @default(0) @map("available_quantity") @db.Decimal(14, 4)
  reservedQuantity     Decimal  @default(0) @map("reserved_quantity") @db.Decimal(14, 4)
  netAvailableQuantity Decimal  @default(0) @map("net_available_quantity") @db.Decimal(14, 4)
  shortageQuantity     Decimal  @default(0) @map("shortage_quantity") @db.Decimal(14, 4)
  unitMwacCost         Decimal  @default(0) @map("unit_mwac_cost") @db.Decimal(18, 4)
  estimatedCost        Decimal  @default(0) @map("estimated_cost") @db.Decimal(14, 2)

  productionPlan     ProductionPlan     @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  productionPlanItem ProductionPlanItem @relation(fields: [productionPlanItemId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem      @relation(fields: [inventoryItemId], references: [id])

  @@index([productionPlanId])
  @@index([inventoryItemId])
  @@map("production_plan_material_requirements")
}

model ProductionPlanStatusHistory {
  id               String                @id @default(uuid())
  productionPlanId String                @map("production_plan_id")
  fromStatus       ProductionPlanStatus? @map("from_status")
  toStatus         ProductionPlanStatus  @map("to_status")
  changedById      String                @map("changed_by_id")
  reason           String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  changedBy      User           @relation(fields: [changedById], references: [id])

  @@index([productionPlanId])
  @@map("production_plan_status_history")
}

// ------------------------------------------------------------------------------
// 10. WORK ORDER MANAGEMENT (PHASE 3.3)
// ------------------------------------------------------------------------------

model WorkOrderNumberSequence {
  id            String   @id @default(uuid())
  prefix        String   @default("WO") @db.VarChar(15)
  financialYear String   @map("financial_year") @db.VarChar(10)
  lastNumber    Int      @default(0) @map("last_number")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([prefix, financialYear])
  @@map("work_order_number_sequences")
}

model WorkOrder {
  id                   String            @id @default(uuid())
  workOrderNumber      String            @unique @map("work_order_number") @db.VarChar(40)
  financialYear        String            @map("financial_year") @db.VarChar(10)
  productionPlanId     String            @map("production_plan_id")
  productionPlanItemId String            @map("production_plan_item_id")
  productVariantId     String            @map("product_variant_id")
  inventoryItemId      String            @map("inventory_item_id")
  bomId                String            @map("bom_id")
  bomVersionId         String            @map("bom_version_id")
  warehouseId          String            @map("warehouse_id")
  uomId                  String            @map("uom_id")
  plannedQuantity        Decimal           @map("planned_quantity") @db.Decimal(14, 4)
  allocatedBatchQuantity Decimal           @default(0) @map("allocated_batch_quantity") @db.Decimal(14, 4)
  actualGoodQuantity     Decimal           @default(0) @map("actual_good_quantity") @db.Decimal(14, 4)
  actualScrapQuantity  Decimal           @default(0) @map("actual_scrap_quantity") @db.Decimal(14, 4)
  priority             WorkOrderPriority @default(NORMAL)
  status               WorkOrderStatus   @default(DRAFT)
  plannedStartDate     DateTime?         @map("planned_start_date") @db.Date
  plannedEndDate       DateTime?         @map("planned_end_date") @db.Date
  productionLine       String?           @map("production_line") @db.VarChar(80)
  assignedToId         String?           @map("assigned_to_id")
  notes                String?           @db.Text
  instructions         String?           @db.Text
  idempotencyKey       String?           @unique @map("idempotency_key") @db.VarChar(100)
  createdById          String            @map("created_by_id")
  submittedById        String?           @map("submitted_by_id")
  submittedAt          DateTime?         @map("submitted_at")
  approvedById         String?           @map("approved_by_id")
  approvedAt           DateTime?         @map("approved_at")
  rejectedById         String?           @map("rejected_by_id")
  rejectedAt           DateTime?         @map("rejected_at")
  rejectionReason      String?           @map("rejection_reason") @db.Text
  releasedById         String?           @map("released_by_id")
  releasedAt           DateTime?         @map("released_at")
  cancelledById        String?           @map("cancelled_by_id")
  cancelledAt          DateTime?         @map("cancelled_at")
  cancellationReason   String?           @map("cancellation_reason") @db.Text
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  productionPlan     ProductionPlan           @relation(fields: [productionPlanId], references: [id])
  productionPlanItem ProductionPlanItem       @relation(fields: [productionPlanItemId], references: [id])
  productVariant     ProductVariant           @relation(fields: [productVariantId], references: [id])
  inventoryItem      InventoryItem            @relation(fields: [inventoryItemId], references: [id])
  bom                BOM                      @relation(fields: [bomId], references: [id])
  bomVersion         BOMVersion               @relation(fields: [bomVersionId], references: [id])
  warehouse          Warehouse                @relation(fields: [warehouseId], references: [id])
  uom                UnitOfMeasure            @relation(fields: [uomId], references: [id])
  assignedTo         User?                    @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  statusHistory      WorkOrderStatusHistory[]
  productionBatches  ProductionBatch[]

  @@index([productionPlanId])
  @@index([productionPlanItemId])
  @@index([productVariantId])
  @@index([bomVersionId])
  @@index([warehouseId])
  @@index([status])
  @@index([plannedStartDate])
  @@map("work_orders")
}

model WorkOrderStatusHistory {
  id          String           @id @default(uuid())
  workOrderId String           @map("work_order_id")
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus  @map("to_status")
  changedById String           @map("changed_by_id")
  reason      String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([workOrderId])
  @@map("work_order_status_history")
}

model ProductionBatchNumberSequence {
  id            String   @id @default(uuid())
  prefix        String   @db.VarChar(15)
  financialYear String   @map("financial_year") @db.VarChar(10)
  lastNumber    Int      @default(0) @map("last_number")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([prefix, financialYear])
  @@map("production_batch_number_sequences")
}

model ProductionBatch {
  id                         String                @id @default(uuid())
  batchNumber                String                @unique @map("batch_number") @db.VarChar(40)
  financialYear              String                @map("financial_year") @db.VarChar(10)
  workOrderId                String                @map("work_order_id")
  productId                  String                @map("product_id")
  productVariantId           String                @map("product_variant_id")
  inventoryItemId            String                @map("inventory_item_id")
  bomId                      String                @map("bom_id")
  bomVersionId               String                @map("bom_version_id")
  warehouseId                String                @map("warehouse_id")
  uomId                      String                @map("uom_id")
  plannedQuantity            Decimal               @map("planned_quantity") @db.Decimal(14, 4)
  actualGoodQuantity         Decimal               @default(0) @map("actual_good_quantity") @db.Decimal(14, 4)
  rejectedQuantity           Decimal               @default(0) @map("rejected_quantity") @db.Decimal(14, 4)
  wastageQuantity            Decimal               @default(0) @map("wastage_quantity") @db.Decimal(14, 4)
  actualYieldPercent         Decimal               @default(0) @map("actual_yield_percent") @db.Decimal(6, 2)
  completionPercent          Decimal               @default(0) @map("completion_percent") @db.Decimal(6, 2)
  wastageReason              String?               @map("wastage_reason") @db.Text
  notes                      String?               @db.Text
  status                     ProductionBatchStatus @default(CREATED)
  operatorId                 String                @map("operator_id")
  startedAt                  DateTime?             @map("started_at")
  pausedAt                   DateTime?             @map("paused_at")
  completedAt                DateTime?             @map("completed_at")
  cancelledAt                DateTime?             @map("cancelled_at")
  cancellationReason         String?               @map("cancellation_reason") @db.Text
  manufacturingDate          DateTime?             @map("manufacturing_date") @db.Date
  expiryDate                 DateTime?             @map("expiry_date") @db.Date
  materialsReserved          Boolean               @default(false) @map("materials_reserved")
  finishedGoodsBatchId       String?               @map("finished_goods_batch_id")
  finishedGoodsReceiptId     String?               @map("finished_goods_receipt_id")
  finishedGoodsTransactionId String?               @map("finished_goods_transaction_id")
  idempotencyKey             String?               @unique @map("idempotency_key") @db.VarChar(100)
  completionIdempotencyKey   String?               @unique @map("completion_idempotency_key") @db.VarChar(100)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  workOrder          WorkOrder                      @relation(fields: [workOrderId], references: [id])
  product            Product                        @relation(fields: [productId], references: [id])
  productVariant     ProductVariant                 @relation(fields: [productVariantId], references: [id])
  inventoryItem      InventoryItem                  @relation(fields: [inventoryItemId], references: [id])
  bom                BOM                            @relation(fields: [bomId], references: [id])
  bomVersion         BOMVersion                     @relation(fields: [bomVersionId], references: [id])
  warehouse          Warehouse                      @relation(fields: [warehouseId], references: [id])
  uom                UnitOfMeasure                  @relation(fields: [uomId], references: [id])
  operator           User                           @relation("BatchOperator", fields: [operatorId], references: [id])
  finishedGoodsBatch InventoryBatch?                @relation("FinishedGoodsBatch", fields: [finishedGoodsBatchId], references: [id])
  consumptions       ProductionBatchConsumption[]
  returns            ProductionBatchReturn[]
  varianceApprovals  ProductionBatchVarianceApproval[]
  qualityInspection  QualityInspection?
  costing            ProductionBatchCosting?
  costEntries        ProductionCostEntry[]
  overheadAllocations ProductionOverheadAllocation[]
  statusHistory      ProductionBatchStatusHistory[]
  executionEntries   ProductionExecutionEntry[]

  @@index([workOrderId])
  @@index([productVariantId])
  @@index([warehouseId])
  @@index([status])
  @@index([operatorId])
  @@map("production_batches")
}

model ProductionBatchConsumption {
  id                     String   @id @default(uuid())
  productionBatchId      String   @map("production_batch_id")
  inventoryItemId        String   @map("inventory_item_id")
  warehouseId            String   @map("warehouse_id")
  batchId                String?  @map("batch_id")
  uomId                  String   @map("uom_id")
  plannedQuantity        Decimal  @default(0) @map("planned_quantity") @db.Decimal(14, 4)
  consumedQuantity       Decimal  @map("consumed_quantity") @db.Decimal(14, 4)
  baseQuantity           Decimal  @map("base_quantity") @db.Decimal(14, 4)
  unitCost               Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost              Decimal  @default(0) @map("total_cost") @db.Decimal(18, 4)
  inventoryIssueId       String?  @map("inventory_issue_id")
  inventoryTransactionId String?  @map("inventory_transaction_id")
  idempotencyKey         String?  @unique @map("idempotency_key") @db.VarChar(100)
  consumedById           String   @map("consumed_by_id")
  consumedAt             DateTime @default(now()) @map("consumed_at")
  notes                  String?  @db.Text

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  batch           InventoryBatch? @relation(fields: [batchId], references: [id])
  uom             UnitOfMeasure   @relation(fields: [uomId], references: [id])
  consumedBy      User            @relation(fields: [consumedById], references: [id])

  @@index([productionBatchId])
  @@index([inventoryItemId])
  @@index([batchId])
  @@map("production_batch_consumptions")
}

model ProductionBatchStatusHistory {
  id                String                 @id @default(uuid())
  productionBatchId String                 @map("production_batch_id")
  fromStatus        ProductionBatchStatus? @map("from_status")
  toStatus          ProductionBatchStatus  @map("to_status")
  changedById       String                 @map("changed_by_id")
  reason            String?                @db.Text
  createdAt         DateTime               @default(now()) @map("created_at")

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  changedBy       User            @relation(fields: [changedById], references: [id])

  @@index([productionBatchId])
  @@map("production_batch_status_history")
}

model ProductionExecutionEntry {
  id                String                       @id @default(uuid())
  productionBatchId String                       @map("production_batch_id")
  entryType         ProductionExecutionEntryType @map("entry_type")
  goodQuantity      Decimal?                     @map("good_quantity") @db.Decimal(14, 4)
  rejectedQuantity  Decimal?                     @map("rejected_quantity") @db.Decimal(14, 4)
  wastageQuantity   Decimal?                     @map("wastage_quantity") @db.Decimal(14, 4)
  reason            String?                      @db.Text
  notes             String?                      @db.Text
  recordedById      String                       @map("recorded_by_id")
  createdAt         DateTime                     @default(now()) @map("created_at")

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation(fields: [recordedById], references: [id])

  @@index([productionBatchId])
  @@map("production_execution_entries")
}

model ProductionBatchReturn {
  id                     String   @id @default(uuid())
  productionBatchId      String   @map("production_batch_id")
  inventoryItemId        String   @map("inventory_item_id")
  warehouseId            String   @map("warehouse_id")
  batchId                String?  @map("batch_id")
  uomId                  String   @map("uom_id")
  returnedQuantity       Decimal  @map("returned_quantity") @db.Decimal(14, 4)
  baseQuantity           Decimal  @map("base_quantity") @db.Decimal(14, 4)
