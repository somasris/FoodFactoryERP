  updatedAt         DateTime               @updatedAt @map("updated_at")

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  approvedBy      User?           @relation(fields: [approvedById], references: [id])

  @@unique([productionBatchId, inventoryItemId])
  @@index([productionBatchId])
  @@map("production_batch_variance_approvals")
}

model QualityInspection {
  id                String             @id @default(uuid())
  inspectionNumber  String             @unique @map("inspection_number") @db.VarChar(40)
  productionBatchId String             @unique @map("production_batch_id")
  inventoryBatchId  String             @map("inventory_batch_id")
  warehouseId       String             @map("warehouse_id")
  inspectedQuantity Decimal            @map("inspected_quantity") @db.Decimal(14, 4)
  goodQuantity      Decimal            @default(0) @map("good_quantity") @db.Decimal(14, 4)
  rejectedQuantity  Decimal            @default(0) @map("rejected_quantity") @db.Decimal(14, 4)
  decision          InspectionDecision @default(PENDING)
  defectCategory    String?            @map("defect_category") @db.VarChar(80)
  notes             String?            @db.Text
  evidenceRef       String?            @map("evidence_ref") @db.VarChar(255)
  inspectorId       String?            @map("inspector_id")
  inspectedAt       DateTime?          @map("inspected_at")
  releasedById      String?            @map("released_by_id")
  releasedAt        DateTime?          @map("released_at")
  releaseNotes      String?            @map("release_notes") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  inventoryBatch  InventoryBatch  @relation(fields: [inventoryBatchId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  inspector       User?           @relation("QualityInspector", fields: [inspectorId], references: [id])
  releasedBy      User?           @relation("QualityReleaser", fields: [releasedById], references: [id])

  @@index([decision])
  @@index([inventoryBatchId])
  @@map("quality_inspections")
}

