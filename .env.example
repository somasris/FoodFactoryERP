# FoodFactory ERP - Environment Variables Template
# Copy this file to .env in your root or apps/api as required for local development.

# Application Environment (development | test | production)
NODE_ENV=development

# Backend Server Port
PORT=5000

# Backend PostgreSQL Database Connection URL
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Default local PostgreSQL connection (port 5433 for local Windows service, or 5432 for Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/foodfactory_erp?schema=public

# Frontend Application Origin for CORS configuration
FRONTEND_URL=http://localhost:5173

# JWT Secret for access token verification (Phase 1.2 preparation)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars_long_placeholder

# Docker Compose PostgreSQL Settings (Optional overrides for docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodfactory_erp
POSTGRES_PORT=5433
