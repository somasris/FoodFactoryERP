# FoodFactory ERP - Environment Variables Template
# Copy this file to .env in your root or apps/api as required for local development.

# Application Environment (development | test | production)
NODE_ENV=development

# Backend Server Port
PORT=5000

# Backend PostgreSQL Database Connection URL
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/foodfactory_erp?schema=public

# Frontend Application Origin for CORS configuration
FRONTEND_URL=http://localhost:5173

# JWT Configuration (Phase 1.3 Authentication)
JWT_ACCESS_SECRET=foodfactory_erp_jwt_secret_foundation_fallback_key_nit_trichy_2026
JWT_REFRESH_SECRET=foodfactory_erp_refresh_pepper_foundation_secret_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Initial Seed OWNER Configuration (Optional for development seed)
# If provided, db:seed idempotently provisions the initial OWNER account.
INITIAL_OWNER_EMAIL=owner@foodfactory.com
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=OwnerSecurePass2026!
INITIAL_OWNER_FULLNAME=Managing Director - FoodFactory

# Docker Compose PostgreSQL Settings (Optional overrides for docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodfactory_erp
POSTGRES_PORT=5433
